use flake

# Local overrides / agent keys (.env is gitignored).
# direnv's `dotenv` has been a silent no-op under this nix-direnv setup;
# `set -a; source` plus explicit exports reliably inject Pioneer/agent vars.
watch_file .env
if [[ -f .env ]]; then
  set -a
  # shellcheck disable=SC1091
  source .env
  set +a
  # Ensure critical keys are exported even if set -a missed edge cases.
  [[ -n "${PIONEER_API_KEY:-}" ]] && export PIONEER_API_KEY
  [[ -n "${OPENAI_API_KEY:-}" ]] && export OPENAI_API_KEY
  [[ -n "${LATTICE_AGENT_PROVIDER:-}" ]] && export LATTICE_AGENT_PROVIDER
  [[ -n "${LATTICE_AGENT_MODEL:-}" ]] && export LATTICE_AGENT_MODEL
  [[ -n "${LATTICE_AGENTD_BIN:-}" ]] && export LATTICE_AGENTD_BIN
  [[ -n "${LATTICE_AGENT_FAKE:-}" ]] && export LATTICE_AGENT_FAKE
  [[ -n "${LATTICE_GITHUB_APP_CLIENT_ID:-}" ]] && export LATTICE_GITHUB_APP_CLIENT_ID
  [[ -n "${LATTICE_EMBEDDING_PROVIDER:-}" ]] && export LATTICE_EMBEDDING_PROVIDER
  [[ -n "${LATTICE_EMBEDDING_MODEL:-}" ]] && export LATTICE_EMBEDDING_MODEL
  [[ -n "${LATTICE_EMBEDDING_DIMENSIONS:-}" ]] && export LATTICE_EMBEDDING_DIMENSIONS
fi

# Decrypt tracked sops secrets into the environment when age key is present.
# Private key: ~/.config/sops/age/keys.txt  (not in the repo)
# Encrypted files under secrets/ are intentionally committed (public-repo safe).
if has sops; then
  watch_file .sops.yaml
  _lt_sops_env="$(mktemp "${TMPDIR:-/tmp}/lattice-sops.XXXXXX")"
  # shellcheck disable=SC2064
  trap "rm -f '${_lt_sops_env}'" EXIT
  for _lt_sops_file in secrets/cloudflare.env secrets/apple.env; do
    if [[ -f "${_lt_sops_file}" ]]; then
      watch_file "${_lt_sops_file}"
      if sops -d "${_lt_sops_file}" > "${_lt_sops_env}"; then
        dotenv "${_lt_sops_env}"
      fi
    fi
  done
  rm -f "${_lt_sops_env}"
  trap - EXIT
  unset _lt_sops_env _lt_sops_file
fi
