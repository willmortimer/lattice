# Boring direnv: Nix flake only. Secrets load via NXR contexts at spawn time
# (agent-openai, agent-pioneer, apple-development, apple-release) or explicitly
# via `scripts/with-secrets.sh` / `sops -d` when needed.
use flake

export LATTICE_CLIENT_ROOT="$PWD"
if [[ -d ../site ]] && [[ -f ../flake.nix ]]; then
  export LATTICE_ECOSYSTEM_ROOT="$(cd .. && pwd)"
fi
