{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lattice",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0a0d13"
      },
      {
        "label": "quick-note",
        "title": "Quick Note",
        "url": "quick-note.html",
        "width": 680,
        "height": 470,
        "minWidth": 520,
        "minHeight": 360,
        "center": true,
        "visible": false,
        "alwaysOnTop": true,
        "resizable": true,
        "skipTaskbar": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0a0d13"
      },
      {
        "label": "capture-shelf",
        "title": "Capture Shelf",
        "url": "capture-shelf.html",
        "width": 280,
        "height": 360,
        "visible": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "resizable": false,
        "skipTaskbar": true,
        "decorations": false,
        "focus": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0a0d13"
      },
      {
        "label": "agent-detached",
        "title": "Lattice Agent",
        "url": "agent-detached.html",
        "width": 420,
        "height": 720,
        "minWidth": 360,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0a0d13"
      }
    ]
  },
  "bundle": {
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "hardenedRuntime": true
    }
  }
}
